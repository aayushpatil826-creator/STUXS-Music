# STUXS Music - Environment Configuration
# Note: Keep service-role keys & client secrets private; never expose them to client applications.

# Supabase Backend (Client-accessible)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public Client Configurations
VITE_ITUNES_API_URL=https://itunes.apple.com

# ----------------------------------------------------------------------------------
# SERVER-SIDE SECRETS (Do NOT prefix with VITE_ or expose to client code)
# Set in Supabase Edge Functions via `supabase secrets set`:
#
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# AMAZON_MUSIC_CLIENT_ID=
# AMAZON_MUSIC_CLIENT_SECRET=
# ----------------------------------------------------------------------------------
