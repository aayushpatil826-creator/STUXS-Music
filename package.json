{
  "name": "stuxs-music",
  "private": true,
  "version": "2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "npm run build && npx cap sync android",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug && powershell -Command \"Copy-Item app\\build\\outputs\\apk\\debug\\app-debug.apk -Destination ..\\stux-music-debug.apk -Force; Copy-Item app\\build\\outputs\\apk\\debug\\app-debug.apk -Destination ..\\stuxs-music-debug.apk -Force\" && cd ..",
    "lint": "oxlint",
    "test": "npx tsx --test src/services/__tests__/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
